# Normalize line endings in the repo; check out with native endings where it matters.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.glb  binary
*.stl  binary
*.step binary
*.dwg  binary
*.zip  binary
*.db   binary
