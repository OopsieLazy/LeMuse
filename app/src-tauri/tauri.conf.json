{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServeNSurf",
  "version": "0.1.0",
  "identifier": "dev.servensurf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ServeNSurf",
        "incognito": true,
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://images.are.na https://d2w9rnfcy7mm78.cloudfront.net https://www.artic.edu https://openaccess-cdn.clevelandart.org; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/ServeNSurf/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
