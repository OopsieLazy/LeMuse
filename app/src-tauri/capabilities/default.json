{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability set for the main window (ADR-0012, ADR-0015, ADR-0016). Every addition is justified in an ADR. Links open only on the source sites LeMuse shows.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.are.na/*" },
        { "url": "https://are.na/*" },
        { "url": "https://clevelandart.org/*" },
        { "url": "https://www.clevelandart.org/*" },
        { "url": "https://www.artic.edu/*" }
      ]
    }
  ]
}
