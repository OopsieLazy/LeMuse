# Rust
/target/
**/target/

# Node / UI
node_modules/
dist/
.vite/

# Tauri generated
app/src-tauri/gen/

# Local data — never commit the user's library or secrets
/library/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# UI preview + validation outputs (ADR-0009); regenerate with npm scripts
app/preview/
app/dist-preview/
app/dist-dashboard/
app/.snapshot/

# Admin-review snapshot of uncommitted work (ADR-0011); never committed
.claude/review/

# Keys and credentials never belong in the repo (review 0006 A-26)
*.pem
*.key
*.pfx
*.p12
credentials*.json

# Outputs of LeMuse commands and local runs (review 0015). This repo is PUBLIC:
# these hold your topics, links, paths (Windows user name) or tokens.
/lemuse.toml
/ui.json
*.toml.lock
.lemuse.toml.*.tmp
*.sqlite
*.sqlite3
*.log
*.har
sheet*.html
*-links.csv
*-links.json
*-links.txt
/*.csv
/*.pdf

# The Are.na token lives only in Windows Credential Manager (ADR-0023). If one
# is ever pasted into a file in this folder by mistake, keep it out of git.
token*.txt
*token.txt
*tokens.txt
*.token
.arena*
arena-token*
arena_token*
/secrets/

# Release outputs (ADR-0028): built in CI, attached to a GitHub Release
/release/
*.cdx.json
SHA256SUMS
*.exe
*.msi
*.msix
