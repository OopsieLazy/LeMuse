# Rust
/target/
**/target/

# Node / UI
node_modules/
dist/
.vite/

# Tauri generated
app/src-tauri/gen/

# Local data — never commit the user's library or secrets
/library/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store

# Claude Code local settings
.claude/settings.local.json

# UI preview + validation outputs (ADR-0009); regenerate with npm scripts
app/preview/
app/dist-preview/
app/dist-dashboard/
app/.snapshot/

# Admin-review snapshot of uncommitted work (ADR-0011); never committed
.claude/review/

# Keys and credentials never belong in the repo (review 0006 A-26)
*.pem
*.key
*.pfx
*.p12
credentials*.json
